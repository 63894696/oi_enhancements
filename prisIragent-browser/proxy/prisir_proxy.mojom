// Prisir 网络链路 Mojo 接口(#59 契约,2026-08-21)
//
// 上游:docs/network-link-singbox-contract-2026-08-21.md(§三 B);
//       docs/m3-fusion-agent-layer-network-link-2026-08-21.md(网络链路段)。
// 定位:浏览器本体「网络链路」通道 —— 用户填自建 VPS 单节点 或 粘机场订阅,
//       本体拉起随包 sing-box 内核起本地 SOCKS/HTTP inbound,只把 Chromium 自身
//       网络栈指向它(经 network_context 运行时 proxy config),不开 TUN、不碰系统代理。
//
// 红线(贯穿,见契约 §四):
//   - 凭证只进不出:SetNode/SetSubscription 接收密钥/订阅,**无 GetNode/GetSubscription**
//     回明文;密钥 os_crypt 加密落 profile(<profile>/Prisir/proxy/link.enc),
//     不落明文、不进 LLM 上下文、审计脱敏。
//   - 网络最小面:只代理浏览器自身进程;不读系统代理、不枚举其它应用流量。
//   - 责任边界:只做协议客户端,不内置节点、不做分发。
//   - 内核不编进本体:sing-box 为随包二进制子进程,handler 看门(崩溃重启/退出清理)。

module prisir.proxy.mojom;

// 单 VPS 节点配置(SetNode 输入)。敏感字段(password/uuid/密钥)由 handler 加密落盘,
// 本结构经 Mojo 进本体后即不留明文副本。
struct ProxyNodeConfig {
  string protocol;    // "ss2022" | "vmess" | "vless" | "trojan" | "hysteria2" | "tuic" | "wireguard"
  string address;     // VPS 域名/IP
  int32 port;         // 端口
  string uuid;        // vmess/vless/tuic 用(可空)
  string password;    // ss2022/trojan/hysteria2 用(可空,敏感)
  string extra_json;  // 协议附加参数(flow/public_key/sni 等,JSON,敏感)
};

// 解析出的节点(订阅列表项,或已存节点摘要)。敏感字段不回,只回展示用元数据。
struct ProxyNode {
  string id;         // 节点 id(本地生成,稳定)
  string tag;        // 显示名(订阅里的备注/节点名)
  string protocol;   // 协议
  string address;    // 地址(展示用,可能脱敏中段)
  int32 port;
  int32 latency_ms;  // 最近测速延迟(-1=未测/超时)
};

// SetNode 结果。
struct SetNodeResult {
  bool ok;
  string node_id;   // 落盘后分配/复用的节点 id
  string error;     // 失败原因(脱敏,不含密钥)
};

// 链路状态(GetStatus/StartLink 返回)。
struct LinkStatus {
  bool running;         // sing-box 子进程是否在跑
  string active_node;   // 当前选中节点 id(空=未选)
  string local_inbound; // 本地 inbound 地址,如 "socks5://127.0.0.1:2080"(空=未起)
  int32 latency_ms;     // 当前链路延迟(-1=未测)
  string error;         // 最近错误(脱敏)
};

// 连通测试结果(TestLink):经链路访问测试 URL 探活。
struct TestResult {
  bool ok;           // 经链路访问海外测试站成功
  int32 latency_ms;  // 往返延迟(-1=失败)
  string via;        // 实际出口 IP/位置(测试站返回,展示用)
  string error;      // 失败原因(脱敏)
};

interface PrisirProxy {
  // ── 节点配置(单 VPS) ──
  // 填单个自建 VPS。敏感字段 os_crypt 加密落 profile,不回明文。
  SetNode(ProxyNodeConfig cfg) => (SetNodeResult res);

  // ── 订阅(机场) ──
  // 粘订阅链接 → 拉取并解析出节点列表(不落明文 token,链接本体加密存)。
  SetSubscription(string url) => (array<ProxyNode> nodes);

  // ── 选择/启停 ──
  SelectNode(string node_id) => (bool ok);
  StartLink() => (LinkStatus s);   // 拉起 sing-box,起本地 inbound 并把浏览器网络栈指向它
  StopLink() => (bool ok);         // 停子进程 + 恢复浏览器直连
  GetStatus() => (LinkStatus s);   // 状态/延迟/当前节点
  TestLink() => (TestResult r);    // 连通测试(经链路访问测试 URL)
};
