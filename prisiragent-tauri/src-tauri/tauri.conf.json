{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrisirAI",
  "version": "2.7.6",
  "identifier": "com.prisir.prisirai",
  "build": {
    "frontendDist": "./frontend",
    "devUrl": "http://localhost:18802"
  },
  "app": {
    "windows": [
      {
        "title": "Prisir(湃睿思) AI",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f6f1e7"
      },
      {
        "label": "lyrics-window",
        "title": "PrisirAI 歌词",
        "width": 720,
        "height": 180,
        "minWidth": 320,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "url": "http://127.0.0.1:0/lyrics"
      },
      {
        "label": "companion-window",
        "title": "PrisirAI · 语伴",
        "width": 920,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f6f1e7",
        "url": "http://127.0.0.1:18850/"
      },
      {
        "label": "music-window",
        "title": "PrisirAI · 音乐",
        "width": 880,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f6f1e7",
        "url": "http://127.0.0.1:0/"
      },
      {
        "label": "calendar-window",
        "title": "PrisirAI · 📅 日历",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f6f1e7",
        "url": "http://127.0.0.1:18803/prisiragent/calendar"
      },
      {
        "label": "workflow-window",
        "title": "PrisirAI · 🔀 工作流",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#f6f1e7",
        "url": "http://127.0.0.1:18802/#wfmodal"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
